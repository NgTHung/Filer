{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Filer Task",
	"type": "object",
	"required": [
		"id",
		"title",
		"status",
		"priority",
		"type"
	],
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[A-Z]+-[0-9]+$"
		},
		"title": {
			"type": "string",
			"minLength": 5
		},
		"status": {
			"type": "string",
			"enum": [
				"To Do",
				"In Progress",
				"Blocked",
				"Done",
				"Deferred",
				"Obsolete"
			]
		},
		"priority": {
			"type": "string",
			"enum": [
				"High",
				"Medium",
				"Low"
			]
		},
		"type": {
			"type": "string",
			"enum": [
				"Milestone",
				"Epic",
				"Feature",
				"Bug",
				"Refactor",
				"TechDebt",
				"TestDebt",
				"Design",
				"Docs"
			]
		},
		"parent": {
			"type": "string",
			"pattern": "^[A-Z]+-[0-9]+$"
		},
		"milestone": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
		},
		"depends_on": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Z]+-[0-9]+$"
			},
			"uniqueItems": true
		},
		"rules": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"uniqueItems": true
		},
		"risk": {
			"type": "string",
			"enum": [
				"High",
				"Medium",
				"Low"
			]
		},
		"impact": {
			"type": "string",
			"minLength": 10
		},
		"tags": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"whitepaper": {
			"type": "string"
		},
		"last_updated": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
		}
	}
}
